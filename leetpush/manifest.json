{
  "manifest_version": 3,
  "name": "LeetPush",
  "version": "0.3.0",
  "description": "Automatically pushes your accepted solutions from LeetCode, Codeforces, CodeChef, HackerRank and GeeksforGeeks to GitHub.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://www.codechef.com/*",
    "https://www.hackerrank.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://practice.geeksforgeeks.org/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["shared.js", "leetcode.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://codeforces.com/*"],
      "js": ["shared.js", "codeforces.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.codechef.com/*"],
      "js": ["shared.js", "codechef.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.hackerrank.com/*"],
      "js": ["shared.js", "hackerrank.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.geeksforgeeks.org/*", "https://practice.geeksforgeeks.org/*"],
      "js": ["shared.js", "gfg.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject-common.js",
        "inject-leetcode.js",
        "inject-codechef.js",
        "inject-hackerrank.js",
        "inject-gfg.js"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://www.codechef.com/*",
        "https://www.hackerrank.com/*",
        "https://www.geeksforgeeks.org/*",
        "https://practice.geeksforgeeks.org/*"
      ]
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "LeetPush" }
}
